# These go in Vercel: Project Settings -> Environment Variables. Never commit real values.

SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The SECRET key. Server only. Never put it in config.js or any page.
SUPABASE_SECRET_KEY=sb_secret_...

# Comma-separated emails allowed to use the dashboard. Nobody can sign in if this is empty.
ALLOWED_EMAILS=agent@example.com

# Same values as your lead_capture .env
APIFY_SOURCE_NAME=apify_reddit
REDDIT_REPLIES_PER_DAY=5
AUTHOR_COOLDOWN_DAYS=14
# Subreddits whose rules allow mentioning the business (comma list, lowercase). Leave empty if unsure.
REDDIT_BRAND_OK_SUBS=
BRAND_NAME=Your Business Name
